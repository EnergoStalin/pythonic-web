{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "checkJs": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "/js/*": ["./js/*"]
    }
  },
  "include": [
    "js/**/*",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
